# ==============================================================================
# AI MEETING ASSISTANT AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Runtime
PROJECT_NAME="AI Meeting Assistant Agent"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_assistant
# Optional full connection URL (e.g., Neon PostgreSQL in production)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-hostname.neon.tech/neondb

# Security & Authentication
# Generate strong key with: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & STT
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL_SIZE=base

# Storage & Uploads
STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=104857600

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
